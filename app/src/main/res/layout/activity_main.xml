<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/camera_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/camera_preview_focus_view"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_focus"
            android:visibility="invisible" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:background="@color/black_transparent"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/image_capture_back"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentStart="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/image_capture_button"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerHorizontal="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_aperture"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_image"
                    app:tint="@color/grey" />

                <TextView
                    android:id="@+id/image_capture_image_count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/grey" />

            </LinearLayout>

        </RelativeLayout>

    </FrameLayout>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:elevation="5dp"
        android:theme="@style/ToolbarTheme" />

    <RelativeLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/map_symbol_fragment"
        android:layout_below="@+id/toolbar"
        android:orientation="vertical">

        <!-- This is the place there the MapView is placed but it's created in the Java code -->

        <!-- View for the note-symbol to stay calm in the center of the screen
         when the user moves the map underneath. The height and padding are used
         to correctly center the icon since its origin is at the _bottom_ center,
         not at the top. -->
        <ImageView
            android:id="@+id/map_icon_move_view"
            android:layout_width="50dp"
            android:layout_height="100dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:clickable="false"
            android:focusable="false"
            android:paddingBottom="50dp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/map_symbol_fragment"
        android:name="de.hauke_stieler.geonotes.map.SymbolFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>